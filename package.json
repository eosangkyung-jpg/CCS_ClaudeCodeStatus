{
  "name": "sideproj-status-widget",
  "version": "0.1.3",
  "description": "CCS (CrazyCatStatus) — 실시간 Claude 사용량을 고양이 사진으로 보여 주는 플로팅 위젯",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:poc": "node poc_fetch_usage.mjs",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.kimbap.sideproj-status-widget",
    "productName": "CCS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CCS",
      "artifactName": "CCS-Setup.${ext}"
    },
    "portable": {
      "artifactName": "CCS-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "src/assets/icon-mac.png",
      "category": "public.app-category.utilities",
      "artifactName": "CCS-mac.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "CCS"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eosangkyung-jpg",
        "repo": "CCS_ClaudeCodeStatus",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [
    "claude",
    "usage",
    "widget",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
